# Zoom Notes Taker Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# PROJECT CONFIGURATION (auto-configured by bootstrap script)
# =============================================================================
# Absolute path to the project directory - DO NOT EDIT MANUALLY
# This is automatically set by bootstrap.sh or bootstrap.bat
ZNT_PROJECT_DIR=

# =============================================================================
# AUDIO CONFIGURATION
# =============================================================================
# macOS: Use "Aggregate Device" (combines BlackHole + Microphone)
# Windows: Use "CABLE Output" (VB-Cable virtual audio)
# Run: python -m src.main devices  to list available devices
ZNT_AUDIO_DEVICE="Aggregate Device"
ZNT_SAMPLE_RATE=16000

# =============================================================================
# WHISPER CONFIGURATION (Speech-to-Text)
# =============================================================================
# Model options: tiny, base, small, medium, large
# Smaller = faster but less accurate, Larger = slower but more accurate
ZNT_WHISPER_MODEL=base

# Language: Leave empty for auto-detect, or set specific language code
# Examples: en (English), ta (Tamil), es (Spanish), fr (French), de (German)
ZNT_WHISPER_LANGUAGE=

# =============================================================================
# LLM PROVIDER CONFIGURATION
# =============================================================================
# Choose your LLM provider: "groq", "ollama", or "huggingface"
# - groq: Fast cloud API, very low cost (RECOMMENDED for SaaS)
# - ollama: Runs locally, requires Ollama to be installed and running
# - huggingface: Uses HuggingFace Inference API, requires HF_TOKEN
ZNT_LLM_PROVIDER=groq

# =============================================================================
# GROQ CONFIGURATION (Recommended - Fast & Low Cost)
# =============================================================================
# Get your FREE API key at: https://console.groq.com/keys
# Groq offers 6,000 requests/day FREE, then very low cost
# Available models:
# - llama-3.1-8b-instant (fast, good quality - RECOMMENDED)
# - llama-3.1-70b-versatile (slower, excellent quality)
# - llama-3.3-70b-versatile (latest, excellent quality)
# - mixtral-8x7b-32768 (large context window)
GROQ_API_KEY=
ZNT_GROQ_MODEL=llama-3.1-8b-instant

# =============================================================================
# OLLAMA CONFIGURATION (Local LLM)
# =============================================================================
# Used when ZNT_LLM_PROVIDER=ollama
# Default model - can be changed at runtime via model selection prompt
# Run: ollama list  to see available models
ZNT_OLLAMA_MODEL=llama3.1:8b
ZNT_OLLAMA_HOST=http://localhost:11434

# =============================================================================
# HUGGINGFACE CONFIGURATION (Cloud LLM)
# =============================================================================
# Used when ZNT_LLM_PROVIDER=huggingface
# Recommended models for meeting summarization:
# - meta-llama/Llama-3.1-8B-Instruct (fast, good quality)
# - mistralai/Mistral-7B-Instruct-v0.3 (fast, good quality)
# - meta-llama/Llama-3.1-70B-Instruct (slower, excellent quality)
ZNT_HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# =============================================================================
# OUTPUT CONFIGURATION
# =============================================================================
# Base directory for meeting notes (auto-organized into subfolders)
# IMPORTANT: Use absolute paths with ~ expanded, not relative paths like "output"
# macOS example: ~/Library/CloudStorage/OneDrive-.../meeting-notes
# Windows example: %USERPROFILE%\OneDrive\meeting-notes
# Note: ZNT_OUTPUT_DIR is also supported for backwards compatibility
ZNT_NOTES_BASE=~/Documents/ZoomNotes/notes

# Directory for temporary audio recordings
ZNT_RECORDINGS_DIR=~/Documents/ZoomNotes/recordings

# =============================================================================
# HUGGINGFACE TOKEN (Required for HuggingFace provider & speaker diarization)
# =============================================================================
# Get your token from: https://huggingface.co/settings/tokens
# This token is used for:
# 1. HuggingFace LLM provider (when ZNT_LLM_PROVIDER=huggingface)
# 2. Speaker diarization (pyannote models)
#
# For speaker diarization, you also need to accept the model license agreements at:
# - https://huggingface.co/pyannote/segmentation-3.0
# - https://huggingface.co/pyannote/speaker-diarization-3.1
#
# Leave empty to disable HuggingFace features (use Ollama instead)
HF_TOKEN=

# =============================================================================
# SUPABASE CONFIGURATION (For SaaS/Cloud mode with subscription)
# =============================================================================
# Get these from your Supabase project: https://supabase.com/dashboard/project/_/settings/api
# This enables the Cloud provider which uses your backend for authenticated LLM calls
#
# When configured, the app will:
# - Require user login
# - Use the Supabase Edge Function to proxy LLM requests
# - Track usage per user
# - Enforce subscription limits (free: 3 meetings/month, pro: unlimited)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Dodo Payments product ID for subscription upgrades
# Get this from your Dodo Payments dashboard after creating a product
DODO_PRODUCT_ID=
