# Zoom Notes Taker Configuration
# Copy this file to .env and customize as needed

# Audio Configuration
ZNT_AUDIO_DEVICE=BlackHole 2ch
ZNT_SAMPLE_RATE=16000

# Whisper Configuration
ZNT_WHISPER_MODEL=base
ZNT_WHISPER_LANGUAGE=en

# Ollama Configuration
ZNT_OLLAMA_MODEL=llama3.2
ZNT_OLLAMA_HOST=http://localhost:11434

# Output Configuration
ZNT_OUTPUT_DIR=./output
ZNT_RECORDINGS_DIR=./recordings

# Hugging Face Token (required for speaker diarization)
# Get your token from: https://huggingface.co/settings/tokens
# You also need to accept the model conditions at:
# - https://huggingface.co/pyannote/segmentation-3.0
# - https://huggingface.co/pyannote/embedding
HF_TOKEN=your_huggingface_token_here
